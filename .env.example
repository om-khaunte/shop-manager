# Public Firebase web-app config (Firebase console → Project settings → Your apps).
# These values are safe to ship to the browser; access is enforced by firestore.rules.
# Never put service-account credentials or Admin SDK keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firestore document ID under shops/ for this deployment.
NEXT_PUBLIC_SHOP_ID=shop-114

# "open": no sign-in, anyone with the link can edit (deploy firestore.open.rules).
# "google": Google sign-in + shop membership (deploy firestore.rules). See README.
NEXT_PUBLIC_AUTH_MODE=open

# Set to "true" only for local development against `npm run emulators`.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
