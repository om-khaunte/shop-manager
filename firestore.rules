rules_version = '2';

// Deny by default. Every allowed path is listed explicitly below.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberPath(shopId) {
      return /databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid);
    }

    function isMember(shopId) {
      return signedIn() && exists(memberPath(shopId));
    }

    // Admins manage the team and can edit. Editors can edit and move things.
    function isAdmin(shopId) {
      return isMember(shopId) && get(memberPath(shopId)).data.role == 'admin';
    }

    function canEdit(shopId) {
      return isMember(shopId) && get(memberPath(shopId)).data.role in ['admin', 'editor'];
    }

    function validLayout() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'schemaVersion', 'revision', 'coordinateUnits', 'width', 'height',
                               'verificationStatus', 'objects', 'updatedAt', 'updatedBy'])
        && d.name is string && d.name.size() <= 120
        && d.schemaVersion is int
        && d.revision is int
        && d.coordinateUnits == 'arbitrary'
        && d.width is number && d.width > 0
        && d.height is number && d.height > 0
        && d.verificationStatus in ['draft', 'verified']
        && d.objects is map && d.objects.size() <= 1500
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }

    function validLocation() {
      let d = request.resource.data;
      return d.keys().hasOnly(['parentId', 'mapObjectId', 'kind', 'label', 'code', 'sortOrder',
                               'diagramPosition', 'archived', 'compartments', 'example', 'updatedAt'])
        && (d.parentId == null || d.parentId is string)
        && (d.mapObjectId == null || d.mapObjectId is string)
        && d.kind in ['unit', 'drawer', 'shelf', 'cubby', 'bin', 'box', 'slot']
        && d.label is string && d.label.size() <= 120
        && d.code is string && d.code.size() <= 40
        && d.sortOrder is number
        && d.archived is bool
        && d.updatedAt == request.time;
    }

    match /shops/{shopId} {
      // Viewing and searching the shop needs no account.
      allow read: if true;
      // Shops are created by the bootstrap procedure (console / Admin SDK), never by clients.
      allow create, delete: if false;
      allow update: if canEdit(shopId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'activeLayoutId']);

      match /members/{uid} {
        // You can read your own membership (to learn your role); admins can see the whole team.
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin(shopId));
        // Only admins grant or change access, and nobody can change their own membership.
        allow create, update: if isAdmin(shopId)
          && uid != request.auth.uid
          && request.resource.data.role in ['admin', 'editor']
          && request.resource.data.keys().hasOnly(['role', 'displayName', 'email', 'addedBy', 'addedAt']);
        allow delete: if isAdmin(shopId) && uid != request.auth.uid;
      }

      // "Please let me edit": a signed-in person asks, an admin approves (creating their
      // membership) or denies (deleting the request). A request never grants anything itself.
      match /requests/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin(shopId));
        allow create: if signedIn()
          && request.auth.uid == uid
          && !exists(memberPath(shopId))
          && request.resource.data.keys().hasOnly(['displayName', 'email', 'note', 'requestedAt'])
          && request.resource.data.requestedAt == request.time
          && (request.resource.data.displayName == null || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 200))
          && (request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 320))
          && (request.resource.data.note == null || (request.resource.data.note is string && request.resource.data.note.size() <= 500));
        // Withdraw your own request, or an admin clears it (approving or denying).
        allow delete: if signedIn() && (request.auth.uid == uid || isAdmin(shopId));
        allow update: if false;
      }

      match /layouts/{layoutId} {
        allow read: if true;
        allow create: if canEdit(shopId) && validLayout() && request.resource.data.revision == 1;
        // Optimistic concurrency: each save must advance the revision by exactly one,
        // so a client holding a stale revision can never overwrite a newer save.
        allow update: if canEdit(shopId) && validLayout()
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }

      match /locations/{locationId} {
        allow read: if true;
        // Locations are archived, never deleted, so item references stay resolvable.
        allow create, update: if canEdit(shopId) && validLocation();
        allow delete: if false;
      }

      // Reserved for the future inventory milestone.
      match /items/{itemId} {
        allow read: if true;
        allow create, update: if canEdit(shopId);
        allow delete: if false;
      }
    }
  }
}
